# ============================================================================
# RUHUNU PRODUCTS - BILLING & INVOICING SUITE
# DATABASE CONFIGURATION FILE (.env)
# ============================================================================

# Database Engine: 'mysql' | 'sqlite' | 'postgres'
DB_ENGINE=mysql

# ----------------------------------------------------------------------------
# MySQL / MariaDB Settings (Matches database.sql)
# ----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ruhunu_products_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ----------------------------------------------------------------------------
# Dedicated Database User Alternative (Optional)
# If you configured 'billing_user' from database.sql, uncomment these lines:
# ----------------------------------------------------------------------------
# DB_USER=billing_user
# DB_PASS=BillingPass@2026

# ----------------------------------------------------------------------------
# Vercel / Cloud PostgreSQL (Optional - for Vercel deployment)
# ----------------------------------------------------------------------------
# POSTGRES_URL=postgres://default:...@...neon.tech:5432/verceldb?sslmode=require
